---
import WhatsappIcon from './icons/WhatsappIcon.astro';
---

<div class="modal-overlay" id="checkout-modal" role="dialog" aria-modal="true" aria-labelledby="checkout-modal-title">
  <div class="checkout-modal-card">
    <button class="modal-close-btn checkout-modal-close" aria-label="Cerrar ventana de pago" type="button">&times;</button>
    
    <div style="text-align: center; margin-bottom: 1.25rem;">
      <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--brand-red-light); color: var(--brand-red); display: flex; align-items: center; justify-content: center; margin: 0 auto 0.75rem;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
      </div>
      <h3 id="checkout-modal-title" style="font-size: 1.45rem; font-weight: 900; color: var(--text-main); margin-bottom: 0.25rem;">
        Finalizar Orden de Pago
      </h3>
      <p style="font-size: 0.85rem; color: var(--text-muted);">
        Total a pagar: <strong id="checkout-final-total" style="color: var(--brand-red); font-size: 1.1rem;">$0 COP</strong>
      </p>
    </div>

    <form id="checkout-payment-form" style="display: flex; flex-direction: column; gap: 0.85rem;">
      <input type="hidden" id="checkout-selected-method" value="pse" />

      <!-- Payment Method Selection Grid -->
      <div>
        <label style="font-size: 0.8rem; font-weight: 700; color: var(--text-main); display: block; margin-bottom: 0.5rem;">
          Selecciona tu método de pago preferido:
        </label>
        <div class="payment-methods-grid">
          <div class="payment-method-card active" data-method="pse">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="22.01"></line><line x1="15" y1="22" x2="15.01"></line><line x1="9" y1="18" x2="9" y2="18.01"></line><line x1="15" y1="18" x2="15.01"></line><line x1="9" y1="14" x2="9" y2="14.01"></line><line x1="15" y1="14" x2="15.01"></line><line x1="9" y1="10" x2="9" y2="10.01"></line><line x1="15" y1="10" x2="15.01"></line><line x1="9" y1="6" x2="9" y2="6.01"></line><line x1="15" y1="6" x2="15.01"></line></svg>
            <span class="payment-method-name">PSE / Banco</span>
          </div>

          <div class="payment-method-card" data-method="nequi">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
            <span class="payment-method-name">Nequi / Daviplata</span>
          </div>

          <div class="payment-method-card" data-method="card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
            <span class="payment-method-name">Tarjeta Crédito</span>
          </div>
        </div>
      </div>

      <!-- Payer Information -->
      <div class="input-with-icon-wrapper">
        <span class="input-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        </span>
        <input type="text" class="input-pill-with-icon" placeholder="Nombre de quien realiza el pago *" required autocomplete="name" />
      </div>

      <div class="input-with-icon-wrapper">
        <span class="input-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </span>
        <input type="email" class="input-pill-with-icon" placeholder="Correo para recibir comprobante y accesos *" required autocomplete="email" />
      </div>

      <div class="input-with-icon-wrapper">
        <span class="input-icon">
          <WhatsappIcon width={18} height={18} color="#25D366" />
        </span>
        <span class="input-country-prefix">+57</span>
        <input type="tel" class="input-pill-with-icon input-phone-colombia" placeholder="WhatsApp *" required autocomplete="tel" />
      </div>

      <button type="submit" class="btn-auth-submit">
        Proceder al Pago Seguro →
      </button>

      <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; font-size: 0.725rem; color: var(--text-light); margin-top: 0.25rem;">
        <span>Conexión Cifrada SSL 256-bit</span>
        <span>•</span>
        <span>Factura Validada DIAN</span>
      </div>
    </form>
  </div>
</div>
