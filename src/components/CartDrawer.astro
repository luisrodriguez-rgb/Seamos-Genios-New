---
import WhatsappIcon from './icons/WhatsappIcon.astro';
---

<!-- Cart Drawer Slide-over Panel -->
<div class="cart-overlay" id="cart-overlay" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title">
  <div class="cart-drawer">
    <!-- Header -->
    <div class="cart-header">
      <h3 class="cart-header-title" id="cart-drawer-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <span>Tu Carrito</span>
        <span class="cart-header-badge"><span class="cart-count-badge">0</span> productos</span>
      </h3>
      <button class="cart-close-btn" aria-label="Cerrar carrito de compras" type="button">&times;</button>
    </div>

    <!-- Body / Items List -->
    <div class="cart-body">
      <!-- Empty State -->
      <div class="cart-empty-state" id="cart-empty-state">
        <svg class="cart-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <h4 class="cart-empty-title">Tu carrito está vacío</h4>
        <p class="cart-empty-desc">Añade un simulacro, plan intensivo o kit de cuadernillos para comenzar a estudiar hoy mismo.</p>
        <a href="#programas" class="cart-close-btn" style="width: auto; height: auto; padding: 0.6rem 1.25rem; border-radius: var(--radius-pill); background: var(--brand-red); color: #FFFFFF; font-size: 0.85rem; font-weight: 700; text-decoration: none; display: inline-flex;">
          Explorar Catálogo →
        </a>
      </div>

      <!-- Dynamic Items Container -->
      <div id="cart-items-container" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>
    </div>

    <!-- Footer / Checkout Summary -->
    <div class="cart-footer" id="cart-footer-section">
      <!-- Coupon Code Input -->
      <div class="cart-coupon-row">
        <input type="text" class="cart-coupon-input" id="cart-coupon-input" placeholder="Código de descuento (ej. ICFES2026)" />
        <button type="button" class="cart-coupon-btn" id="btn-apply-coupon">Aplicar</button>
      </div>

      <!-- Financial Totals Table -->
      <div class="cart-summary-table">
        <div class="cart-summary-row">
          <span>Subtotal:</span>
          <span id="cart-subtotal-val">$0 COP</span>
        </div>
        <div class="cart-summary-row discount" id="cart-discount-row" style="display: none;">
          <span>Descuento aplicado:</span>
          <span id="cart-discount-val">-$0 COP</span>
        </div>
        <div class="cart-summary-row total">
          <span>Total a Pagar:</span>
          <span id="cart-total-val" style="color: var(--brand-red);">$0 COP</span>
        </div>
      </div>

      <!-- Checkout Action Buttons -->
      <button type="button" class="cart-checkout-btn-main" data-open-checkout>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
        <span>Pagar con PSE / Nequi / Tarjeta</span>
      </button>

      <a href="#" id="btn-cart-wa-checkout" target="_blank" rel="noopener noreferrer" class="cart-checkout-btn-wa" aria-label="Comprar y Enviar Pedido por WhatsApp">
        <WhatsappIcon width={18} height={18} color="#FFFFFF" />
        <span>Comprar y Enviar Pedido por WhatsApp</span>
      </a>

      <!-- Trust Badges -->
      <div class="cart-trust-badges">
        <span>Pagos 100% Seguros</span>
        <span>•</span>
        <span>Entrega en 24h</span>
        <span>•</span>
        <span>Factura Legal DIAN</span>
      </div>
    </div>
  </div>
</div>
