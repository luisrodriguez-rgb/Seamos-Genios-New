---

<section class="trust-bar" id="respaldo">
  <div class="container">
    <div class="trust-stats-grid">
      <div>
        <div class="trust-stat-val" data-counter="1.400+">1.400+</div>
        <div class="trust-stat-lbl">Estudiantes Activos</div>
      </div>
      <div>
        <div class="trust-stat-val" data-counter="450+">450+</div>
        <div class="trust-stat-lbl">Puntajes Superiores a 450</div>
      </div>
      <div>
        <div class="trust-stat-val" data-counter="15+">15+</div>
        <div class="trust-stat-lbl">Ediciones de Simulacros</div>
      </div>
      <div>
        <div class="trust-stat-val" data-counter="98%">98%</div>
        <div class="trust-stat-lbl">Satisfacción Garantizada</div>
      </div>
    </div>

    <div style="text-align: center; margin-top: 1.5rem;">
      <div style="font-size: 0.8rem; font-weight: 800; text-transform: uppercase; color: var(--text-light); letter-spacing: 0.05em; margin-bottom: 1.25rem;">
        Respaldado por mentores e investigadores de las mejores universidades del país
      </div>
      <div class="alliances-pills-row">
        <span class="alliance-pill">
          <span class="alliance-icon-badge">UN</span> Universidad Nacional de Colombia
        </span>
        <span class="alliance-pill">
          <span class="alliance-icon-badge">UA</span> Universidad de los Andes
        </span>
        <span class="alliance-pill">
          <span class="alliance-icon-badge">UIS</span> Universidad Industrial de Santander
        </span>
        <span class="alliance-pill">
          <span class="alliance-icon-badge">PUJ</span> Pontificia Universidad Javeriana
        </span>
        <span class="alliance-pill">
          <span class="alliance-icon-badge">UR</span> Universidad del Rosario
        </span>
        <span class="alliance-pill">
          <span class="alliance-icon-badge">UI</span> Universidad Icesi
        </span>
      </div>
    </div>
  </div>
</section>
