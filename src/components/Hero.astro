---
---

<section class="hero" id="hero">
  <div class="container hero-grid">
    <!-- Left Column -->
    <div>
      <!-- Pill Badge -->
      <div class="hero-badge-pill">
        <span class="badge-icon-circle">+</span> PREPARACIÓN INTELIGENTE PARA EL ICFES 2026
      </div>

      <h1 class="hero-main-title">
        Tu mejor resultado<br />
        en el <span class="text-brand-red">ICFES</span><br />
        empieza aquí.
      </h1>

      <p class="hero-main-desc">
        Entrena con simulacros reales de 254 preguntas, recibe análisis predictivo en menos de 24 horas y mejora tu puntaje con neurociencia e IA.
      </p>

      <!-- Quick Role Navigation Selector in Hero -->
      <div style="margin: 1.25rem 0 1.5rem;">
        <span style="font-size: 0.8rem; font-weight: 800; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.05em; display: block; margin-bottom: 0.5rem;">
          Selecciona tu perfil para guiarte:
        </span>
        <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
          <button type="button" class="btn btn-secondary" data-jump-role="estudiante" style="padding: 0.35rem 0.85rem; font-size: 0.8rem; border-radius: var(--radius-pill); cursor: pointer;">
            Estudiante
          </button>
          <button type="button" class="btn btn-secondary" data-jump-role="colegio" style="padding: 0.35rem 0.85rem; font-size: 0.8rem; border-radius: var(--radius-pill); cursor: pointer;">
            Colegio / Rector
          </button>
          <button type="button" class="btn btn-secondary" data-jump-role="padre" style="padding: 0.35rem 0.85rem; font-size: 0.8rem; border-radius: var(--radius-pill); cursor: pointer;">
            Familia / Acudiente
          </button>
          <button type="button" class="btn btn-secondary" data-jump-role="docente" style="padding: 0.35rem 0.85rem; font-size: 0.8rem; border-radius: var(--radius-pill); cursor: pointer;">
            Docente
          </button>
        </div>
      </div>

      <!-- Hero Action Buttons -->
      <div class="hero-actions-row">
        <button class="btn-hero-primary" data-open-modal data-modal-mode="register" type="button">
          Inscribirme al Programa →
        </button>
        <a href="#programas" class="btn-hero-secondary" id="btn-hero-how-it-works">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          Ver Programas & Tienda
        </a>
      </div>

      <!-- 4 Value Proposition Items -->
      <div class="hero-features-strip">
        <div class="hero-feature-pill">
          <div class="feat-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <span>Simulacros<br />reales</span>
        </div>

        <div class="hero-feature-pill">
          <div class="feat-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg>
          </div>
          <span>Resultados<br />en 24h</span>
        </div>

        <div class="hero-feature-pill">
          <div class="feat-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.04z"/></svg>
          </div>
          <span>Método propio<br />con neurociencia</span>
        </div>

        <div class="hero-feature-pill">
          <div class="feat-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <span>Acompañamiento<br />constante</span>
        </div>
      </div>

      <!-- Bottom Info Card -->
      <div class="hero-bottom-info-card">
        <div class="info-card-col">
          <div class="info-card-head">
            <span class="live-dot-green"></span>
            <strong>+1.500 estudiantes</strong>
          </div>
          <span class="info-card-sub">ya están alcanzando sus metas</span>
        </div>
        <div class="info-card-divider"></div>
        <div class="info-card-col">
          <div class="info-card-head">
            <strong>Examen Saber 11 • 26 de julio de 2026</strong>
          </div>
          <span class="info-card-sub">
            Quedan <span id="cd-days" style="font-weight: 800; color: var(--brand-red);">155</span> días de preparación
          </span>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Dashboard Card -->
    <div class="hero-dashboard-card">
      <!-- Top Bar: Tu progreso & Dropdown -->
      <div class="dash-top-bar">
        <div class="dash-prog-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF1E27" stroke-width="2.5"><path d="M23 6l-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg>
          <span>Tu progreso</span>
        </div>
        <div class="dash-dropdown-pill">
          <span>Último simulacro</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
      </div>

      <!-- Score Box with Sparkline -->
      <div class="dash-score-box">
        <div class="dash-score-meta">
          <span class="dash-score-lbl">Puntaje Global</span>
          <div class="dash-score-num">
            <span class="score-red">324</span> <span class="score-total">/ 500</span>
          </div>
          <div class="dash-score-delta">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="3"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
            <span><strong>42 puntos</strong> desde tu anterior simulacro</span>
          </div>
        </div>
        <div class="dash-chart-wrap">
          <svg class="dash-sparkline" viewBox="0 0 200 90" fill="none">
            <defs>
              <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#FF1E27" stop-opacity="0.25"/>
                <stop offset="100%" stop-color="#FF1E27" stop-opacity="0.0"/>
              </linearGradient>
            </defs>
            <path d="M 10 75 Q 40 68, 70 52 T 130 45 T 160 38 T 190 12 L 190 85 L 10 85 Z" fill="url(#chartGrad)"/>
            <path d="M 10 75 Q 40 68, 70 52 T 130 45 T 160 38 T 190 12" stroke="#FF1E27" stroke-width="3" stroke-linecap="round"/>
            <circle cx="190" cy="12" r="5" fill="#FF1E27"/>
            <circle cx="190" cy="12" r="8" fill="#FF1E27" fill-opacity="0.3"/>
          </svg>
        </div>
      </div>

      <!-- Areas Performance Section -->
      <div class="dash-areas-head">
        <span class="dash-areas-title">Desempeño por áreas</span>
        <a href="#metodologia" class="dash-areas-link">Ver detalle →</a>
      </div>

      <!-- 4 Subject Area Cards -->
      <div class="dash-areas-grid">
        <!-- Area 1: Lectura Crítica -->
        <div class="area-card">
          <div class="area-icon-wrap icon-purple">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div class="area-name">Lectura Crítica</div>
          <div class="area-percent">84%</div>
          <div class="area-bar-bg"><div class="area-bar-fill" style="width: 84%;"></div></div>
        </div>

        <!-- Area 2: Matemáticas -->
        <div class="area-card">
          <div class="area-icon-wrap icon-blue">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </div>
          <div class="area-name">Matemáticas</div>
          <div class="area-percent">78%</div>
          <div class="area-bar-bg"><div class="area-bar-fill" style="width: 78%;"></div></div>
        </div>

        <!-- Area 3: Ciencias Naturales -->
        <div class="area-card">
          <div class="area-icon-wrap icon-green">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2v7.31M14 2v7.31M8.5 2h7M14 9.3a6.5 6.5 0 1 1-4 0"/></svg>
          </div>
          <div class="area-name">Ciencias Naturales</div>
          <div class="area-percent">71%</div>
          <div class="area-bar-bg"><div class="area-bar-fill" style="width: 71%;"></div></div>
        </div>

        <!-- Area 4: Sociales y Ciudadanas -->
        <div class="area-card">
          <div class="area-icon-wrap icon-violet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg>
          </div>
          <div class="area-name">Sociales y Ciudadanas</div>
          <div class="area-percent">76%</div>
          <div class="area-bar-bg"><div class="area-bar-fill" style="width: 76%;"></div></div>
        </div>
      </div>

      <!-- Bottom Split Widgets -->
      <div class="dash-bottom-widgets">
        <!-- Widget 1: Fortalece tus habilidades -->
        <div class="widget-card widget-skills">
          <div class="widget-skills-content">
            <div class="widget-skills-title">Fortalece tus habilidades</div>
            <div class="widget-skills-desc">Sigue practicando y supera tu mejor versión.</div>
          </div>
          <div class="widget-rocket-wrap">
            <svg class="widget-rocket-svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#FF1E27" stroke-width="1.75"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 9V4s3.03.55 4 2c1.08 1.62 0 5 0 5"/></svg>
          </div>
        </div>

        <!-- Widget 2: Racha actual -->
        <div class="widget-card widget-streak">
          <div class="widget-streak-head">
            <span>Racha actual</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#FF1E27" stroke="none"><path d="M12 2c1.5 3 4 5 4 8a6 6 0 1 1-12 0c0-3 2.5-5 4-8 1 2 2 3 4 0z"/></svg>
          </div>
          <div class="widget-streak-num">7 días</div>
          <div class="widget-streak-sub">¡Sigue así!</div>
        </div>
      </div>
    </div>
  </div>
</section>
