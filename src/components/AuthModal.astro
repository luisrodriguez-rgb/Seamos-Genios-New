---
import WhatsappIcon from './icons/WhatsappIcon.astro';
---

<div class="modal-overlay" id="auth-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="auth-modal-card">
    <button class="modal-close-btn" aria-label="Cerrar ventana modal" type="button">&times;</button>
    
    <!-- Left Side: Brand Panel (Obsidian Dark with Red Ambient Light) -->
    <div class="auth-brand-side">
      <div class="auth-brand-head">
        <img src="/assets/logo-white.svg" alt="Seamos Genios Logo" class="auth-brand-logo" width="140" height="38" loading="lazy" />
        <h2 class="auth-brand-title">Ecosistema Seamos Genios</h2>
        <p class="auth-brand-desc">
          Plataforma líder en neuroaprendizaje y preparación analítica para el examen de estado ICFES Saber 11 en Colombia.
        </p>
      </div>

      <!-- Metrics Cards Stack -->
      <div class="auth-metrics-stack">
        <div class="auth-metric-pill">
          <span class="auth-stat-num">+1.500</span>
          <span class="auth-stat-lbl">Alumnos</span>
        </div>
        <div class="auth-metric-pill">
          <span class="auth-stat-num">477</span>
          <span class="auth-stat-lbl">Puntaje Máx</span>
        </div>
        <div class="auth-metric-pill">
          <span class="auth-stat-num">24h</span>
          <span class="auth-stat-lbl">Reportes</span>
        </div>
      </div>

      <!-- Trust Chip -->
      <div class="auth-trust-chip">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
        <span>Avalado por rectores en +60 instituciones</span>
      </div>
    </div>

    <!-- Right Side: Form & Controls -->
    <div class="auth-form-side">
      <!-- Mode Tabs: Inscribirme vs Iniciar Sesión -->
      <div class="auth-mode-tabs">
        <button type="button" class="auth-mode-tab active" data-mode="register">
          Crear Cuenta / Inscribirme
        </button>
        <button type="button" class="auth-mode-tab" data-mode="login">
          Iniciar Sesión
        </button>
      </div>

      <!-- Role Selector Pills (Only relevant in register mode) -->
      <div class="role-pill-group" id="modal-role-pill-group">
        <button type="button" class="role-tab-btn active" data-role="estudiante">
          Estudiante
        </button>
        <button type="button" class="role-tab-btn" data-role="colegio">
          Colegio
        </button>
        <button type="button" class="role-tab-btn" data-role="padre">
          Familia
        </button>
        <button type="button" class="role-tab-btn" data-role="docente">
          Docente
        </button>
      </div>

      <div class="auth-form-head">
        <h3 class="auth-form-title" id="modal-title">
          Bienvenido a Seamos Genios
        </h3>
        <p class="auth-form-desc" id="modal-role-desc">
          Acceso a simulacros calibrados de 254 preguntas y tutor con IA.
        </p>
      </div>

      <!-- Form -->
      <form id="modal-lead-form" style="display: flex; flex-direction: column; gap: 0.85rem;">
        <input type="hidden" id="modal-role-input" value="estudiante" />
        <input type="hidden" id="modal-form-mode" value="register" />
        
        <!-- Name Field -->
        <div class="input-with-icon-wrapper" id="field-name-wrapper">
          <span class="input-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </span>
          <input type="text" class="input-pill-with-icon" placeholder="Nombre Completo *" required autocomplete="name" />
        </div>

        <!-- School Name Field (Conditional for Colegios) -->
        <div class="input-with-icon-wrapper" id="field-school-wrapper" style="display: none;">
          <span class="input-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="22.01"></line><line x1="15" y1="22" x2="15.01"></line></svg>
          </span>
          <input type="text" class="input-pill-with-icon" placeholder="Nombre de la Institución y Ciudad *" autocomplete="organization" />
        </div>

        <!-- Email Field -->
        <div class="input-with-icon-wrapper">
          <span class="input-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </span>
          <input type="email" class="input-pill-with-icon" placeholder="Correo Electrónico *" required autocomplete="email" />
        </div>

        <!-- WhatsApp / Phone Field -->
        <div class="input-with-icon-wrapper" id="field-phone-wrapper">
          <span class="input-icon">
            <WhatsappIcon width={18} height={18} color="#25D366" />
          </span>
          <span class="input-country-prefix">+57</span>
          <input type="tel" class="input-pill-with-icon input-phone-colombia" placeholder="WhatsApp / Teléfono *" required autocomplete="tel" />
        </div>

        <button type="submit" class="btn-auth-submit" id="modal-submit-btn">
          Inscribirme / Agendar Diagnóstico →
        </button>

        <p style="font-size: 0.725rem; color: var(--text-light); text-align: center; margin-top: 0.25rem;">
          Al continuar aceptas nuestros Términos de Servicio y Política de Privacidad de Datos.
        </p>
      </form>
    </div>
  </div>
</div>
