---
---

<section class="section section-surface" id="equipo">
  <div class="container">
    <div class="section-header">
      <div class="badge">Mentores de Excelencia</div>
      <h2 class="section-title">El Equipo Detrás de los <span class="text-gradient-red">Resultados</span></h2>
      <p class="section-subtitle">
        Docentes e investigadores con puntajes récord provenientes de las universidades más prestigiosas del país.
      </p>
    </div>

    <!-- Leadership Highlight Split -->
    <div class="leadership-highlight">
      <!-- Leader 1 -->
      <div class="leader-card">
        <div class="leader-card-head">
          <div class="leader-avatar-circle">DD</div>
          <div class="leader-info">
            <span class="badge">Fundador & Presidente</span>
            <h3>Daniel De La Cruz</h3>
            <div class="leader-role">Universidad del Rosario • Ciencia de Datos</div>
          </div>
        </div>
        <p class="leader-bio">
          Condecorado dos veces por excelencia académica en Samsung Innovation Campus. Ganador de Hackathons de programación e inteligencia de datos, apasionado por revolucionar la educación en Colombia.
        </p>
      </div>

      <!-- Leader 2 -->
      <div class="leader-card">
        <div class="leader-card-head">
          <div class="leader-avatar-circle">AP</div>
          <div class="leader-info">
            <span class="badge">Vicepresidente (475 Puntos)</span>
            <h3>Ángel Pacheco</h3>
            <div class="leader-role">UNAL & Uniandes • Doble Titulación</div>
          </div>
        </div>
        <p class="leader-bio">
          Subió de 408 a 475 puntos en el examen ICFES. Cursa Ingeniería Agrícola en la Universidad Nacional y Matemáticas Puras en la Universidad de los Andes de manera simultánea.
        </p>
      </div>
    </div>

    <!-- Mentors Structured Table -->
    <div class="table-wrapper">
      <table class="mentors-table">
        <thead>
          <tr>
            <th>Mentor / Docente</th>
            <th>Especialidad Académica</th>
            <th>Universidad de Origen</th>
            <th>Puntaje Destacado ICFES</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Daniel Cuaspoca</strong></td>
            <td>Ciencias Exactas & Física</td>
            <td>UIS (Medicina)</td>
            <td><span style="color: var(--brand-red); font-weight: 800;">477 Puntos (348 → 477)</span></td>
          </tr>
          <tr>
            <td><strong>Alexandra Nitiol</strong></td>
            <td>Lectura Crítica & Lenguas</td>
            <td>UNAL (Medicina)</td>
            <td><span style="color: var(--brand-red); font-weight: 800;">428 Puntos (C1 Oxford)</span></td>
          </tr>
          <tr>
            <td><strong>David Cardona</strong></td>
            <td>Sociales & Ciudadanas</td>
            <td>Universidad Icesi</td>
            <td><span style="color: var(--brand-red); font-weight: 800;">477 Puntos (Primera presentación)</span></td>
          </tr>
          <tr>
            <td><strong>Jesús Tovar</strong></td>
            <td>Ciencias Naturales & Biología</td>
            <td>Univ. Surcolombiana</td>
            <td><span>405 Puntos</span></td>
          </tr>
          <tr>
            <td><strong>Heilen Aranda</strong></td>
            <td>Lectura Crítica & Filosofía</td>
            <td>Univ. del Tolima</td>
            <td><span style="color: var(--brand-red); font-weight: 800;">424 Puntos (Récord Institucional)</span></td>
          </tr>
          <tr>
            <td><strong>Carlos Murillo</strong></td>
            <td>Filosofía & Derecho</td>
            <td>Unipamplona (Derecho)</td>
            <td><span>441 Puntos (353 → 441)</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
