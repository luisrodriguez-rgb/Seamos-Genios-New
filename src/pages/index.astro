---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Alliances from '../components/Alliances.astro';
import RoleHub from '../components/RoleHub.astro';
import PurposeStory from '../components/PurposeStory.astro';
import FlowSteps from '../components/FlowSteps.astro';
import NetworkMap from '../components/NetworkMap.astro';
import EcommerceCatalog from '../components/EcommerceCatalog.astro';
import SchoolsCarousel from '../components/SchoolsCarousel.astro';
import Testimonials from '../components/Testimonials.astro';
import TeamMentors from '../components/TeamMentors.astro';
import Comparison from '../components/Comparison.astro';
import FaqVideo from '../components/FaqVideo.astro';
import ContactWhatsapp from '../components/ContactWhatsapp.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import AuthModal from '../components/AuthModal.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<Layout>
  <!-- 1. Master Navbar -->
  <Navbar />

  <main role="main">
    <!-- 2. Hero Section -->
    <Hero />

    <!-- 3. Trust Bar & University Alliances -->
    <Alliances />

    <!-- 4. Multi-Role Guided Information Hub -->
    <RoleHub />

    <!-- 5. Purpose & Story (Photo + Floating Card) -->
    <PurposeStory />

    <!-- 6. Methodology 4-Step Flow -->
    <FlowSteps />

    <!-- 7. National Network Map & Stats -->
    <NetworkMap />

    <!-- 8. Academic Programs & E-Commerce Catalog -->
    <EcommerceCatalog />

    <!-- 9. Continuous Infinite Marquee of +60 Schools -->
    <SchoolsCarousel />

    <!-- 10. Wall of Love / Testimonials -->
    <Testimonials />

    <!-- 11. Academic Leadership & Mentors Table -->
    <TeamMentors />

    <!-- 12. Market Showdown & Colombian Payment Gateways -->
    <Comparison />

    <!-- 13. FAQ & Video Tour (Brand Red Section) -->
    <FaqVideo />

    <!-- 14. Direct Contact & WhatsApp Banner -->
    <ContactWhatsapp />
  </main>

  <!-- 15. Monumental Footer -->
  <Footer />

  <!-- 16. Floating WhatsApp Pill Button -->
  <FloatingWhatsApp />

  <!-- 17. E-Commerce Slide-over Cart Drawer -->
  <CartDrawer />

  <!-- 18. Multi-Gateway Checkout Modal -->
  <CheckoutModal />

  <!-- 19. Redesigned Auth / Registration Modal -->
  <AuthModal />
</Layout>
